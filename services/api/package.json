{
  "name": "@even/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant cloud API for the Dev HUD. Deployed to Railway with managed Postgres.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "migrate": "node --env-file=.env src/db/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10"
  }
}
